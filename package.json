{
  "name": "figma-translation-plugin",
  "version": "1.0.0",
  "description": "Figma plugin to translate text in frames using Gemini API",
  "main": "code.js",
  "scripts": {
    "build": "esbuild code.ts --bundle --outfile=code.js --target=es2017",
    "watch": "esbuild code.ts --bundle --outfile=code.js --target=es2017 --watch"
  },
  "keywords": [
    "figma",
    "plugin",
    "translation",
    "gemini"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@figma/plugin-typings": "^1.90.0",
    "esbuild": "^0.19.0",
    "typescript": "^5.3.3"
  }
}
